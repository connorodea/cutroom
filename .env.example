# Cutroom — environment template. Copy to `.env` and fill in. NEVER commit `.env`.

# Anthropic API key for the ⌘K AI Agent. Server-side only; never exposed to the client.
ANTHROPIC_API_KEY=sk-ant-...

# Model used to generate edit plans. Default is snappy; swap to claude-opus-4-8 for deeper plans.
CUTROOM_AGENT_MODEL=claude-sonnet-4-6

# Agent server port (Vite dev-proxies /api -> this port).
PORT=8787
