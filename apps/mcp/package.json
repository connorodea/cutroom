{
  "name": "@cutroom/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cutroom MCP server — exposes Cutroom (transcribe/edit/transcript-cut) as tools for AI agents.",
  "bin": { "cutroom-mcp": "dist/index.mjs" },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.mjs --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cutroom/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
